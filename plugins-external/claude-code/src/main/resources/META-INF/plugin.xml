<idea-plugin>
  <id>io.sdopenide.claudecode</id>
  <name>Claude Code CLI</name>
  <vendor url="https://github.com/MartynovAleksey/IDE">SD-OpenIDE</vendor>
  <description><![CDATA[
    <a href="https://claude.com/claude-code">Claude Code</a> in the IDE: a Claude Code tool window with chat tabs (streamed answers, tool cards, diffs,
    permission prompts) and terminal tabs running the bundled <code>claude</code> CLI in the project root, and Settings | Tools | Claude Code with ANTHROPIC_BASE_URL, ANTHROPIC_AUTH_TOKEN and ANTHROPIC_CUSTOM_HEADERS. <code>claude</code> is also on PATH of local terminals. Ships Claude Code for its OS.
  ]]></description>
  <depends>com.intellij.modules.platform</depends>
  <depends>org.jetbrains.plugins.terminal</depends>
  <depends>com.intellij.modules.jcef</depends>

  <extensions defaultExtensionNs="com.intellij">
    <toolWindow id="Claude Code" anchor="right" icon="/icons/claude.svg"
                factoryClass="io.sdopenide.claudecode.ClaudeCodeToolWindowFactory"
                secondary="false"
                canCloseContents="true"/>
    <applicationConfigurable groupId="tools" displayName="Claude Code" id="sd.claudecode"
                             instance="io.sdopenide.claudecode.ClaudeCodeSettingsConfigurable"/>
  </extensions>
  <extensions defaultExtensionNs="org.jetbrains.plugins.terminal">
    <shellExecOptionsCustomizer implementation="io.sdopenide.claudecode.ClaudeCodePathCustomizer"/>
  </extensions>
</idea-plugin>
